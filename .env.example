PORT=8787
ADMIN_TOKEN=change-me
XAI_API_KEY=            # xAI console -> API keys. Blank = MOCK vision (nothing payable)
XAI_VISION_MODEL=grok-4 # any vision-capable Grok model
STRIPE_SECRET_KEY=      # sk_test_... first. Blank = checkout/payouts disabled
STRIPE_WEBHOOK_SECRET=  # whsec_... from the Stripe webhook for /api/stripe/webhook
BASE_URL=https://your-domain
DAILY_PAYOUT_CAP=200
CASHOUT_MIN=5
HOLD_HOURS=24
SMS_PROVIDER=          # set once Twilio Verify is wired into sendSMS()
OPERATOR_EMAIL=
